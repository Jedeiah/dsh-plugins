{
  "name": "@local/web-fetch-fakeip",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "抓取兼容 fake-ip 代理：复用官方 HTTP 抓取提供方的整条流水线，只额外放行本地 TUN 代理（Clash / Shadowrocket）的 fake-ip 段，让 web_fetch 开着代理时也能正常工作。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-web-fetch-http": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
