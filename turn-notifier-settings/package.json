{
  "name": "@jedeiah/turn-notifier-settings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "回合提醒的设置页（配对包）：把 @jedeiah/turn-notifier 那一行的配置页放在一个不会被停用的 bundle 里，这样停用→启用提醒那一行之后，右侧 `›` 设置入口不会跟着消失。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
