{
  "name": "@local/chrome-devtools-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Connects the Chrome DevTools MCP server (chrome-devtools-mcp over stdio) to this dsh profile.",
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
