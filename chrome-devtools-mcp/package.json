{
  "name": "@jedeiah/chrome-devtools-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把 Chrome DevTools MCP 服务器（chrome-devtools-mcp，stdio 桥接）接进本 dsh profile：原先手写在 profile patch 里的那几行现在由本组合包管理。",
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
